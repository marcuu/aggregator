# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TrueLayer (sandbox: https://auth.truelayer-sandbox.com)
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/api/ob/callback
TRUELAYER_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte hex key for app-layer encryption of OB tokens (openssl rand -hex 32)
OB_TOKEN_ENCRYPTION_KEY=

# Shared secret for the Vercel cron endpoint
CRON_SECRET=

# Vercel AI Gateway — required for the /api/chat route. On Vercel
# deployments the gateway authenticates via OIDC and this can be left
# unset; locally, generate a key in the Vercel dashboard.
AI_GATEWAY_API_KEY=
